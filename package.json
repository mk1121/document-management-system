{
  "name": "docudigitize-pro-lossless",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "build:capacitor": "./build-capacitor-new.sh",
    "build:pwa": "next build",
    "build:android": "npm run build:capacitor && npm run android:sync && cd android && ./gradlew assembleDebug && cd ..",
    "build:android:release": "npm run build:capacitor && npm run android:sync && cd android && ./gradlew assembleRelease && cd ..",
    "android:open": "npx @capacitor/cli open android",
    "android:sync": "npx @capacitor/cli sync android",
    "android:run": "npx @capacitor/cli run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "classnames": "^2.5.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "lucide-react": "^0.561.0",
    "next": "^15.1.3",
    "oracledb": "^6.6.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-image-crop": "^11.0.10",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.1.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next-pwa": "^5.6.0",
    "postcss": "^8.4.39",
    "prettier": "^3.7.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.50.0"
  }
