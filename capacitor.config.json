{
  "appId": "com.docudigitize.app",
  "appName": "DocuDigitize Pro",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "fd.informatixsystems.com"
    ]
  },
  "ios": {
    "contentInset": "automatic"
  },
  "android": {
    "buildOptions": {
      "keystorePath": null,
      "keystorePassword": null,
      "keystoreAlias": null,
      "keystoreAliasPassword": null,
      "signingMethod": "jarsigner",
      "androidGradleVersion": "8.1.0"
    }
  },
  "plugins": {
    "Camera": {
      "permissions": [
        "camera",
        "photos"
      ]
    }
  }
}